<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Single entry point for the rover's ros2_control block.

    Call this macro from the main URDF/xacro after including this file:

        <xacro:swerve_ros2_control is_sim="$(arg is_sim)" can_channel="can0"/>

    is_sim="true"  -> emits the gz_ros2_control (Gazebo) system + the
                      GazeboSimROS2ControlPlugin loader, exactly as before.
    is_sim="false" -> emits the real SwerveHardwareInterface system talking
                      to the actuators over CAN.

    can_id values below are PLACEHOLDERS -- set them to the actual CAN node
    IDs of your steering and wheel-drive actuators.

    Steering joints also accept optional <param> overrides, all with defaults
    in the plugin (see JointCfg in swerve_hardware_interface.hpp), e.g.:
      <param name="max_current_A">10.0</param>
      <param name="max_speed_pos_rpm">360.0</param>
      <param name="accel_rpm_s">3000.0</param>
      <param name="decel_rpm_s">3000.0</param>
      <param name="zero_on_activate">false</param>  <!-- leave false unless you
        have no other homing reference; see hpp comment before enabling -->
  -->
  <xacro:macro name="swerve_ros2_control" params="is_sim:=true can_channel:=can0">

    <!-- ============================= SIMULATION ============================= -->
    <xacro:if value="${is_sim}">

      <ros2_control name="SwerveControl" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="a1_bl">
          <command_interface name="position">
            <param name="min">-100</param>
            <param name="max">100</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
        <joint name="a2_bl">
          <command_interface name="position">
            <param name="min">-100</param>
            <param name="max">100</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
        <joint name="a3_bl">
          <command_interface name="position">
            <param name="min">-100</param>
            <param name="max">100</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
        <joint name="a4_bl">
          <command_interface name="position">
            <param name="min">-100</param>
            <param name="max">100</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
        <joint name="w1_a1">
          <command_interface name="velocity">
            <param name="min">-2.5</param>
            <param name="max">2.5</param>
          </command_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
        <joint name="w2_a2">
          <command_interface name="velocity">
            <param name="min">-2.5</param>
            <param name="max">2.5</param>
          </command_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
        <joint name="w3_a3">
          <command_interface name="velocity">
            <param name="min">-2.5</param>
            <param name="max">2.5</param>
          </command_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
        <joint name="w4_a4">
          <command_interface name="velocity">
            <param name="min">-2.5</param>
            <param name="max">2.5</param>
          </command_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
      </ros2_control>

      <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find amr_description)/config/controller.yaml</parameters>
        </plugin>
      </gazebo>

    </xacro:if>

    <!-- ============================== HARDWARE =============================== -->
    <xacro:unless value="${is_sim}">

      <ros2_control name="SwerveRoverSystem" type="system">
        <hardware>
          <plugin>swerve_rover_control/SwerveHardwareInterface</plugin>
          <param name="can_channel">${can_channel}</param>
        </hardware>

        <!-- Steering actuators: position command + position/velocity state -->
        <joint name="a1_bl">
          <param name="can_id">0x11</param>
          <param name="min_angle_rad">-1.5708</param>
          <param name="max_angle_rad">1.5708</param>  <!-- ±90 deg range -->
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="a2_bl">
          <param name="can_id">0x12</param>
          <param name="min_angle_rad">-1.5708</param>
          <param name="max_angle_rad">1.5708</param>  <!-- ±90 deg range -->
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="a3_bl">
          <param name="can_id">0x13</param>
          <param name="min_angle_rad">-1.5708</param>
          <param name="max_angle_rad">1.5708</param>  <!-- ±90 deg range -->
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="a4_bl">
          <param name="can_id">0x14</param>
          <param name="min_angle_rad">-1.5708</param>
          <param name="max_angle_rad">1.5708</param>  <!-- ±90 deg range -->
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

        <!-- Wheel drive actuators: velocity command + position/velocity state -->
        <joint name="w1_a1">
          <param name="can_id">0x21</param>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="w2_a2">
          <param name="can_id">0x22</param>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="w3_a3">
          <param name="can_id">0x23</param>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="w4_a4">
          <param name="can_id">0x24</param>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>

    </xacro:unless>

  </xacro:macro>

</robot>
